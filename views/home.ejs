<%- include('partials/header') %>
<%
const f = (typeof formData !== 'undefined' && formData) ? formData : {};

function esc(s) {
  return String(s === undefined || s === null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

/** Drafts may hold DD/MM/YYYY; <input type="date"> needs YYYY-MM-DD. */
function toDateInput(v) {
  const s = String(v === undefined || v === null ? '' : v).trim();
  if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
  const m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(s);
  return m ? `${m[3]}-${m[2]}-${m[1]}` : '';
}

/** Numeric quantity field. */
function numField(name, label, opts) {
  const o = opts || {};
  const col = o.col || 'col-sm-6 col-lg-4';
  const unit = o.unit === undefined ? 'MT' : o.unit;
  const tip = o.tip ? ` <i class="bi bi-info-circle fld-tip" data-tip="${esc(o.tip)}" tabindex="0"></i>` : '';
  return `<div class="${col}">
    <div class="fld">
      <label class="fld-label" for="${esc(name)}">${esc(label)}${tip}</label>
      <div class="fld-wrap${unit ? ' has-unit' : ''}">
        <input type="text" id="${esc(name)}" name="${esc(name)}" value="${esc(f[name] || '')}"
               class="form-control fld-input js-num" inputmode="decimal" autocomplete="off" placeholder="0.00">
        ${unit ? `<span class="fld-unit">${esc(unit)}</span>` : ''}
      </div>
    </div>
  </div>`;
}

/** Whole-number field (counts). */
function intField(name, label, opts) {
  const o = opts || {};
  const col = o.col || 'col-sm-6 col-lg-4';
  return `<div class="${col}">
    <div class="fld">
      <label class="fld-label" for="${esc(name)}">${esc(label)}</label>
      <div class="fld-wrap">
        <input type="text" id="${esc(name)}" name="${esc(name)}" value="${esc(f[name] || '')}"
               class="form-control fld-input js-int" inputmode="numeric" autocomplete="off" placeholder="0">
      </div>
    </div>
  </div>`;
}

/** Free-text field. */
function textField(name, label, opts) {
  const o = opts || {};
  const col = o.col || 'col-sm-6 col-lg-4';
  return `<div class="${col}">
    <div class="fld">
      <label class="fld-label" for="${esc(name)}">${esc(label)}</label>
      <div class="fld-wrap">
        <input type="text" id="${esc(name)}" name="${esc(name)}" value="${esc(f[name] || '')}"
               class="form-control fld-input" autocomplete="off" placeholder="${esc(o.placeholder || '')}">
      </div>
    </div>
  </div>`;
}

/** Date field — native picker, submitted as YYYY-MM-DD and normalised server-side. */
function dateField(name, label, opts) {
  const o = opts || {};
  const col = o.col || 'col-sm-6 col-lg-4';
  return `<div class="${col}">
    <div class="fld">
      <label class="fld-label" for="${esc(name)}">${esc(label)}</label>
      <div class="fld-wrap">
        <input type="date" id="${esc(name)}" name="${esc(name)}" value="${esc(toDateInput(f[name]))}"
               class="form-control fld-input js-date">
      </div>
    </div>
  </div>`;
}

const SECTIONS = [
  { id: 'sec-period',     num: 1, icon: 'bi-calendar-event', title: 'Filing Period' },
  { id: 'sec-cane',       num: 2, icon: 'bi-speedometer2',   title: 'Cane Crushed' },
  { id: 'sec-production', num: 3, icon: 'bi-gear-wide-connected', title: 'Production' },
  { id: 'sec-dispatches', num: 4, icon: 'bi-truck',          title: 'Dispatches' },
  { id: 'sec-export',     num: 5, icon: 'bi-box-arrow-up-right', title: 'Export' },
  { id: 'sec-import',     num: 6, icon: 'bi-box-arrow-in-down-right', title: 'Import' },
  { id: 'sec-stock',      num: 7, icon: 'bi-boxes',          title: 'Stock of Sugar' },
  { id: 'sec-packing',    num: 8, icon: 'bi-bag-check',      title: 'Packing Details' },
  { id: 'sec-dues',       num: 9, icon: 'bi-cash-stack',     title: 'Cane Dues Data' }
];
%>

<!-- Navbar -->
<nav class="app-navbar">
  <div class="container-fluid px-4 d-flex align-items-center justify-content-between">
    <a href="/" class="brand">
      <div class="brand-icon"><i class="bi bi-building"></i></div>
      <span>P2 Form</span>
      <span class="pill pill-accent d-none d-sm-inline"><%= user.plantName %></span>
    </a>
    <div class="nav-actions">
      <a href="/drafts" class="btn btn-ghost btn-sm" title="My Drafts"><i class="bi bi-archive"></i><span class="d-none d-md-inline ms-1">Drafts</span></a>
      <a href="/past-requests" class="btn btn-ghost btn-sm" title="Past Requests"><i class="bi bi-clock-history"></i><span class="d-none d-md-inline ms-1">History</span></a>
      <span class="nav-user d-none d-xl-flex"><i class="bi bi-person-circle"></i> <%= user.email %></span>
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme"></button>
      <a href="/logout" class="btn btn-ghost btn-sm" title="Log out"><i class="bi bi-box-arrow-right"></i></a>
    </div>
  </div>
</nav>

<div class="form-shell">

  <!-- ============ STICKY SIDE NAVIGATOR ============ -->
  <aside class="form-nav" id="formNav">
    <div class="form-nav-inner">
      <div class="form-nav-progress">
        <div class="progress-ring">
          <svg viewBox="0 0 44 44">
            <circle class="ring-bg" cx="22" cy="22" r="19"></circle>
            <circle class="ring-fg" cx="22" cy="22" r="19" id="progressRing"></circle>
          </svg>
          <span id="progressPct">0%</span>
        </div>
        <div class="form-nav-progress-text">
          <strong id="progressFilled">0</strong> of <span id="progressTotal">0</span> fields filled
        </div>
      </div>

      <ul class="form-nav-list">
        <% SECTIONS.forEach(s => { %>
          <li>
            <a href="#<%= s.id %>" class="form-nav-item" data-target="<%= s.id %>">
              <span class="form-nav-num"><%= s.num %></span>
              <i class="bi <%= s.icon %>"></i>
              <span class="form-nav-title"><%= s.title %></span>
              <span class="form-nav-check"><i class="bi bi-check-circle-fill"></i></span>
            </a>
          </li>
        <% }); %>
      </ul>

      <div class="form-nav-foot">
        <span class="autosave-chip" id="autosaveChip"><i class="bi bi-cloud-check"></i> <span>Draft autosaved locally</span></span>
      </div>
    </div>
  </aside>

  <!-- ============ MAIN FORM ============ -->
  <main class="form-main">

    <div class="page-head">
      <div>
        <h1 class="page-title">P2 Monthly Return</h1>
        <p class="page-sub">Directorate of Sugar &middot; National Single Window System</p>
      </div>
      <button type="button" class="btn btn-ghost btn-sm" id="restoreLocalBtn" style="display:none;">
        <i class="bi bi-arrow-counterclockwise me-1"></i> Restore unsaved work
      </button>
    </div>

    <!-- Mill Info Bar -->
    <div class="info-bar">
      <div class="info-bar-label"><i class="bi bi-shield-check me-1"></i> Mill details (auto-filled from your account)</div>
      <div class="info-bar-grid">
        <div class="info-item"><strong>Undertaking</strong> <span><%= user.undertakingName %></span></div>
        <div class="info-item"><strong>Plant</strong> <span><%= user.plantName %> (<%= user.plantCode %>)</span></div>
        <div class="info-item"><strong>State</strong> <span><%= user.state %></span></div>
        <div class="info-item"><strong>SWS ID</strong> <span><%= user.swsId %></span></div>
        <div class="info-item"><strong>Capacity</strong> <span><%= user.capacity %> TCD/TPD</span></div>
        <div class="info-item"><strong>Approval ID</strong> <span><%= user.approvalId %></span></div>
      </div>
    </div>

      <div class="alert-modern alert-danger-modern" id="formErrors" <%- (typeof errors !== 'undefined' && errors && errors.length) ? '' : 'style="display:none;"' %>>
        <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          <div>
            <strong>Please fix <%= errors.length %> issue<%= errors.length > 1 ? 's' : '' %>:</strong>
            <ul><% errors.forEach(msg => { %><li><%= msg %></li><% }); %></ul>
          </div>
        <% } %>
      </div>

    <form method="POST" action="/preview" id="p2Form" novalidate>

      <!-- ================= 1. FILING PERIOD ================= -->
      <section class="card form-section" id="sec-period">
        <div class="card-header"><span class="sec-num">1</span><i class="bi bi-calendar-event"></i> Filing Period</div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-sm-6">
              <div class="fld">
                <label class="fld-label" for="sugarSeasonSelect">Sugar Season <span class="req">*</span></label>
                <select name="sugarSeason" id="sugarSeasonSelect" class="form-select fld-input" required onchange="updateCaneDuesSeasons()">
                  <option value="">Select season…</option>
                  <% ['2028-29','2027-28','2026-27','2025-26','2024-25','2023-24','2022-23','2021-22','2020-21','2019-20','2018-19'].forEach(s => { %>
                    <option value="<%= s %>" <%= f.sugarSeason === s ? 'selected' : '' %>><%= s %></option>
                  <% }); %>
                </select>
                <small class="fld-hint">Drives the five Cane Dues season rows below.</small>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="fld">
                <label class="fld-label" for="monthSelect">Month <span class="req">*</span></label>
                <select name="month" id="monthSelect" class="form-select fld-input" required>
                  <option value="">Select month…</option>
                  <% ['October','November','December','January','February','March','April','May','June','July','August','September'].forEach(m => { %>
                    <option value="<%= m %>" <%= f.month === m ? 'selected' : '' %>><%= m %></option>
                  <% }); %>
                </select>
                <small class="fld-hint">Submitted to NSWS in upper case.</small>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= 2. CANE CRUSHED ================= -->
      <section class="card form-section" id="sec-cane">
        <div class="card-header"><span class="sec-num">2</span><i class="bi bi-speedometer2"></i> Cane Crushed</div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-sm-6">
              <div class="fld">
                <label class="fld-label">Capacity (TCD / TPD)</label>
                <div class="fld-wrap locked">
                  <input type="text" class="form-control fld-input" value="<%= user.capacity %>" disabled>
                  <span class="fld-unit"><i class="bi bi-lock-fill"></i></span>
                </div>
                <small class="fld-hint">From your account — contact the administrator to change it.</small>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="fld">
                <label class="fld-label" for="caneCrushedMonth">Cane Crushed during the month <span class="req">*</span></label>
                <div class="fld-wrap has-unit">
                  <input type="text" id="caneCrushedMonth" name="caneCrushedMonth" value="<%= f.caneCrushedMonth || '' %>"
                         class="form-control fld-input js-num" inputmode="decimal" required autocomplete="off" placeholder="0.00">
                  <span class="fld-unit">MT</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= 3. PRODUCTION ================= -->
      <section class="card form-section" id="sec-production">
        <div class="card-header">
          <span class="sec-num">3</span><i class="bi bi-gear-wide-connected"></i>
          Production of White / Refined / Raw Sugar
          <span class="sec-count" data-count-for="sec-production"></span>
        </div>
        <div class="card-body">
          <p class="sec-help"><i class="bi bi-lightbulb"></i> Switch on the sub-sections you need to fill in. NSWS expects the complete P2 return every month, so sub-sections left off are still filed &mdash; as 0.00.</p>

          <!-- 2(I) White / Refined -->
          <div class="sub-section">
            <div class="sub-head">
              <div class="form-check form-switch">
                <input type="checkbox" class="form-check-input toggle-section" name="prod_white_enabled" id="prodWhite" data-target="prodWhiteFields" <%= f.prod_white_enabled ? 'checked' : '' %>>
                <label class="form-check-label" for="prodWhite">2(I) White / Refined Sugar</label>
              </div>
            </div>
            <div class="collapse-fields" id="prodWhiteFields" <%= f.prod_white_enabled ? '' : 'hidden' %>>
              <div class="row g-3">
                <%- numField('white_from_cane', 'a) From Cane', { tip: 'a) From Cane - During the Month (MT)' }) %>
                <%- numField('white_from_reprocessing', 'b) From reprocessing unmarketable old sugar', { tip: 'b) From Reprocessing unmarketable old Sugar - During the Month (MT)' }) %>
                <%- numField('white_from_raw_procured', 'c) From raw procured from other domestic mills', { tip: 'c) From raw procured from other domestic sugar mills - During the Month (MT)' }) %>
                <%- numField('white_from_transferred', 'c(1) From transferred white sugar (other domestic mills)', { tip: 'c(1) From transferred white sugar from other domestic sugar mills - During the Month (MT)' }) %>
                <%- numField('white_from_own_raw', 'c(2) From raw sugar used from own stock', { tip: 'c(2) From Raw Sugar used from own Stock - During the Month (MT)' }) %>
                <%- numField('white_from_own_raw_produced', 'c(3) White sugar produced from own raw stock', { tip: 'c(3) White sugar produced from own stock of raw sugar - During the Month (MT)' }) %>
              </div>
              <div class="calc-strip" data-sum="white_from_cane,white_from_reprocessing,white_from_raw_procured,white_from_transferred,white_from_own_raw,white_from_own_raw_produced">
                <i class="bi bi-calculator"></i> Total white / refined sugar produced: <strong>0.00</strong> MT
              </div>
            </div>
          </div>

          <!-- 2(II) Raw Sugar -->
          <div class="sub-section">
            <div class="sub-head">
              <div class="form-check form-switch">
                <input type="checkbox" class="form-check-input toggle-section" name="prod_raw_enabled" id="prodRaw" data-target="prodRawFields" <%= f.prod_raw_enabled ? 'checked' : '' %>>
                <label class="form-check-label" for="prodRaw">2(II) Raw Sugar</label>
              </div>
            </div>
            <div class="collapse-fields" id="prodRawFields" <%= f.prod_raw_enabled ? '' : 'hidden' %>>
              <div class="row g-3">
                <%- numField('raw_from_cane', 'a) From Cane', { tip: 'a) From Cane - During the Month (MT)' }) %>
                <%- numField('raw_from_reprocessing', 'b) From reprocessing unmarketable old sugar', { tip: 'b) From Reprocessing unmarketable old Sugar - During the Month (MT)' }) %>
                <%- numField('raw_procured_domestic', 'c) Raw sugar procured from other domestic mills', { tip: 'c) Raw sugar procured from other domestic sugar mills' }) %>
              </div>
            </div>
          </div>

          <!-- 2(III) Procured Sugar -->
          <div class="sub-section">
            <div class="sub-head">
              <div class="form-check form-switch">
                <input type="checkbox" class="form-check-input toggle-section" name="prod_procured_enabled" id="prodProcured" data-target="prodProcuredFields" <%= f.prod_procured_enabled ? 'checked' : '' %>>
                <label class="form-check-label" for="prodProcured">2(III) Procured Sugar</label>
              </div>
            </div>
            <div class="collapse-fields" id="prodProcuredFields" <%= f.prod_procured_enabled ? '' : 'hidden' %>>
              <div class="row g-3">
                <%- numField('procured_internal_transfer', 'a) Raw sugar — internal transfer from group mills', { tip: 'a) Raw Sugar - Internal transfer from other group sugar mills - During the Month (MT)' }) %>
                <%- textField('procured_transfer_plant_code', 'Internal transfer — Plant Code', { placeholder: 'e.g. 66801' }) %>
                <%- textField('procured_transfer_plant_name', 'Internal transfer — Plant Name', { placeholder: 'Plant name' }) %>
                <%- numField('procured_imported_raw', 'b) From imported raw sugar', { tip: 'b) From Imported Raw Sugar - During the Month (MT)' }) %>
              </div>
            </div>
          </div>

          <!-- 3(1) Diversion -->
          <div class="sub-section">
            <div class="sub-head">
              <div class="form-check form-switch">
                <input type="checkbox" class="form-check-input toggle-section" name="prod_diversion_enabled" id="prodDiv" data-target="prodDivFields" <%= f.prod_diversion_enabled ? 'checked' : '' %>>
                <label class="form-check-label" for="prodDiv">3(1) Diversion / sale of B-heavy, syrup, juice &amp; sugar</label>
              </div>
            </div>
            <div class="collapse-fields" id="prodDivFields" <%= f.prod_diversion_enabled ? '' : 'hidden' %>>
              <div class="row g-3">
                <%- numField('div_syrup_ethanol', '(i) Syrup / juice / sugar diverted for ethanol', { tip: '(i).a. Qty of Syrup/Sugarcane Juice/Sugar diverted for ethanol - During the Month (in MT)' }) %>
                <%- numField('div_bheavy_ethanol', '(ii) B-Heavy diverted for ethanol', { tip: '(ii).a. Qty of B-Heavy diverted for ethanol - During the Month (MT)' }) %>
                <%- numField('div_cheavy_ethanol', '(iii) C-Heavy diverted for ethanol', { tip: '(iii).a. Qty of C-Heavy diverted for ethanol - During the Month (MT)' }) %>
                <%- numField('div_bheavy_sale', '(iv) Sale of B-Heavy', { tip: '(iv) Sale of B-Heavy - During the Month (MT)' }) %>
                <%- numField('div_syrup_sale', '(v) Sale of syrup / juice / sugar', { tip: '(v) Sale of Syrup/Sugarcane Juice/Sugar - During the Month (MT)' }) %>
                <%- numField('div_cheavy_sale', '(vi) Sale of C-Heavy', { tip: '(vi) Sale of C-Heavy - During the Month (MT)' }) %>
              </div>
            </div>
          </div>

          <!-- 3(2) Ethanol -->
          <div class="sub-section">
            <div class="sub-head">
              <div class="form-check form-switch">
                <input type="checkbox" class="form-check-input toggle-section" name="prod_ethanol_enabled" id="prodEthanol" data-target="prodEthanolFields" <%= f.prod_ethanol_enabled ? 'checked' : '' %>>
                <label class="form-check-label" for="prodEthanol">3(2) Ethanol Production</label>
              </div>
            </div>
            <div class="collapse-fields" id="prodEthanolFields" <%= f.prod_ethanol_enabled ? '' : 'hidden' %>>
              <div class="row g-3">
                <%- numField('ethanol_syrup', '(i) From in-house syrup / juice / sugar', { unit: 'KL', tip: '(i).b. Ethanol Production from In-house Syrup/Sugarcane Juice/Sugar - During the Month (in KL)' }) %>
                <%- numField('ethanol_bheavy', '(ii) From in-house B-Heavy', { unit: 'KL', tip: '(ii).b. Ethanol Production from In-house B-Heavy - During the Month (in KL)' }) %>
                <%- numField('ethanol_cheavy', '(iii) From in-house C-Heavy', { unit: 'KL', tip: '(iii).b. Ethanol Production from In-house C-Heavy - During the Month (in KL)' }) %>
              </div>
            </div>
          </div>

          <!-- 4. Recovery (always sent) -->
          <div class="sub-section always-on">
            <div class="sub-head">
              <h6><i class="bi bi-pin-angle-fill"></i> 4. Recovery % age <span class="pill pill-accent">Always submitted</span></h6>
            </div>
            <div class="row g-3">
              <%- numField('recovery_purity', '4(i) Purity of mixed juice (monthly average)', { unit: '%', col: 'col-sm-6', tip: '4 (i) Purity of Mixed Juice (Monthly Average) - During Month (in MT)' }) %>
              <%- numField('recovery_pol', '4(ii) Pol in mixed juice % cane (monthly average)', { unit: '%', col: 'col-sm-6', tip: '4 (ii) Pol in Mixed Juice % Cane (Monthly Average) - During the Month (in MT)' }) %>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= 4. DISPATCHES ================= -->
      <section class="card form-section" id="sec-dispatches">
        <div class="card-header">
          <span class="sec-num">4</span><i class="bi bi-truck"></i> Dispatches
          <span class="sec-count" data-count-for="sec-dispatches"></span>
        </div>
        <div class="card-body">
          <p class="sec-help"><i class="bi bi-lightbulb"></i> Release-order dispatches (6.1.x) and the BISS entry each hold a single record. Sections 6.3&ndash;6.5 accept multiple mills. Sub-sections left switched off are still filed as 0.00.</p>

          <%
            const dispatchSections = [
              { id: '611', label: '6.1.1 Domestic dispatch w.r.t. monthly release quantity' },
              { id: '612', label: '6.1.2 Domestic dispatch w.r.t. additional allotment' },
              { id: '613', label: '6.1.3 Domestic dispatch w.r.t. extended quota' },
              { id: '614', label: '6.1.4 Any other domestic dispatch' }
            ];
          %>
          <% dispatchSections.forEach(ds => { %>
            <div class="sub-section">
              <div class="sub-head">
                <div class="form-check form-switch">
                  <input type="checkbox" class="form-check-input toggle-section" name="disp_<%= ds.id %>_enabled" id="disp<%= ds.id %>" data-target="disp<%= ds.id %>Fields" <%= f['disp_' + ds.id + '_enabled'] ? 'checked' : '' %>>
                  <label class="form-check-label" for="disp<%= ds.id %>"><%= ds.label %></label>
                </div>
              </div>
              <div class="collapse-fields" id="disp<%= ds.id %>Fields" <%= f['disp_' + ds.id + '_enabled'] ? '' : 'hidden' %>>
                <div class="row g-3">
                  <%- dateField('disp_' + ds.id + '_date', 'Release order date', { col: 'col-sm-6 col-lg-3' }) %>
                  <%- numField('disp_' + ds.id + '_qty_released', 'Qty released', { col: 'col-sm-6 col-lg-3' }) %>
                  <%- numField('disp_' + ds.id + '_qty_dispatched', 'Qty dispatched during the month', { col: 'col-sm-6 col-lg-3' }) %>
                  <%- textField('disp_' + ds.id + '_remarks', 'Remarks', { col: 'col-sm-6 col-lg-3', placeholder: 'Optional' }) %>
                </div>
              </div>
            </div>
          <% }); %>

          <!-- 6.2 BISS -->
          <div class="sub-section">
            <div class="sub-head">
              <div class="form-check form-switch">
                <input type="checkbox" class="form-check-input toggle-section" name="disp_62_enabled" id="disp62" data-target="disp62Fields" <%= f.disp_62_enabled ? 'checked' : '' %>>
                <label class="form-check-label" for="disp62">6.2 BISS dispatch of unmarketable old sugar for reprocessing</label>
              </div>
            </div>
            <div class="collapse-fields" id="disp62Fields" <%= f.disp_62_enabled ? '' : 'hidden' %>>
              <div class="row g-3">
                <%- dateField('disp_62_date', 'Release order date', { col: 'col-sm-6' }) %>
                <%- numField('disp_62_qty', 'Qty used for reprocessing', { col: 'col-sm-6' }) %>
              </div>
            </div>
          </div>

          <!-- 6.3 / 6.4 / 6.5 repeatable -->
          <%
            const serialSections = [
              { id: '63', label: '6.3 Internal transfer of raw sugar within a group' },
              { id: '64', label: '6.4 Internal transfer of white sugar within a group' },
              { id: '65', label: '6.5 Sale of raw sugar to other mills (domestic)' }
            ];
          %>
          <% serialSections.forEach(ss => {
               const existing = [];
               for (let i = 1; i <= 25; i++) {
                 const pc = f['disp_' + ss.id + '_' + i + '_plant_code'];
                 const q  = f['disp_' + ss.id + '_' + i + '_qty'];
                 if ((pc && String(pc).trim() !== '') || (q && String(q).trim() !== '')) existing.push({ i, pc: pc || '', q: q || '' });
               }
               const rows = existing.length ? existing : [{ i: 1, pc: '', q: '' }];
          %>
            <div class="sub-section">
              <div class="sub-head">
                <div class="form-check form-switch">
                  <input type="checkbox" class="form-check-input toggle-section" name="disp_<%= ss.id %>_enabled" id="disp<%= ss.id %>" data-target="disp<%= ss.id %>Fields" <%= f['disp_' + ss.id + '_enabled'] ? 'checked' : '' %>>
                  <label class="form-check-label" for="disp<%= ss.id %>"><%= ss.label %></label>
                </div>
              </div>
              <div class="collapse-fields" id="disp<%= ss.id %>Fields" <%= f['disp_' + ss.id + '_enabled'] ? '' : 'hidden' %>>
                <div class="repeater" data-prefix="disp_<%= ss.id %>" data-max="25">
                  <div class="repeater-head">
                    <span class="rp-col-sr">#</span>
                    <span class="rp-col-a">Plant code of receiving mill</span>
                    <span class="rp-col-b">Qty transferred (MT)</span>
                    <span class="rp-col-x"></span>
                  </div>
                  <div class="repeater-rows">
                    <% rows.forEach((r, idx) => { %>
                      <div class="repeater-row">
                        <span class="rp-col-sr serial-badge"><%= idx + 1 %></span>
                        <span class="rp-col-a"><input type="text" name="disp_<%= ss.id %>_<%= idx + 1 %>_plant_code" class="form-control fld-input" placeholder="Plant code" value="<%= r.pc %>" autocomplete="off"></span>
                        <span class="rp-col-b"><input type="text" name="disp_<%= ss.id %>_<%= idx + 1 %>_qty" class="form-control fld-input js-num" inputmode="decimal" placeholder="0.00" value="<%= r.q %>" autocomplete="off"></span>
                        <span class="rp-col-x"><button type="button" class="rp-remove" title="Remove row"><i class="bi bi-x-lg"></i></button></span>
                      </div>
                    <% }); %>
                  </div>
                  <button type="button" class="btn btn-outline-accent btn-sm rp-add"><i class="bi bi-plus-lg me-1"></i>Add mill</button>
                </div>
              </div>
            </div>
          <% }); %>

          <!-- HSN -->
          <div class="sub-section always-on">
            <div class="sub-head">
              <h6><i class="bi bi-pin-angle-fill"></i> HSN code and related details <span class="pill pill-accent">Always submitted</span></h6>
            </div>
            <div class="row g-3">
              <%- numField('hsn_17011490', 'HSN 17011490 — total sales', { tip: 'Total Quantity of Sales (in MT) for HSN Code - 17011490' }) %>
              <%- numField('hsn_17019990', 'HSN 17019990 — total sales', { tip: 'Total Quantity of Sales (in MT) for HSN Code - 17019990' }) %>
              <%- numField('hsn_others', 'Other HSN codes — total sales', { tip: 'Total Quantity of Sales (in MT) for HSN Code - Others' }) %>
            </div>
            <div class="calc-strip" data-sum="hsn_17011490,hsn_17019990,hsn_others">
              <i class="bi bi-calculator"></i> Total sales across HSN codes: <strong>0.00</strong> MT
            </div>
          </div>
        </div>
      </section>

      <!-- ================= 5. EXPORT ================= -->
      <section class="card form-section" id="sec-export">
        <div class="card-header">
          <span class="sec-num">5</span><i class="bi bi-box-arrow-up-right"></i> Export
          <span class="sec-count" data-count-for="sec-export"></span>
        </div>
        <div class="card-body">
          <p class="sec-help"><i class="bi bi-lightbulb"></i> Switch on only what applies. All four export sub-sections are filed every month &mdash; the ones left off go as 0.00.</p>

          <!-- 6.6(a)(i) -->
          <div class="sub-section">
            <div class="sub-head">
              <div class="form-check form-switch">
                <input type="checkbox" class="form-check-input toggle-section" name="exp_661_enabled" id="exp661" data-target="exp661Fields" <%= f.exp_661_enabled ? 'checked' : '' %>>
                <label class="form-check-label" for="exp661">6.6(a)(i) Export under OGL / export quota — white &amp; refined sugar</label>
              </div>
            </div>
            <div class="collapse-fields" id="exp661Fields" <%= f.exp_661_enabled ? '' : 'hidden' %>>
              <div class="row g-3">
                <%- textField('exp_661_order_no', 'Release order no.', { col: 'col-sm-6 col-lg-3' }) %>
                <%- dateField('exp_661_date', 'Release order date', { col: 'col-sm-6 col-lg-3' }) %>
                <%- numField('exp_661_qty_released', 'Qty released', { col: 'col-sm-6 col-lg-3' }) %>
                <%- numField('exp_661_qty_dispatched', 'Qty dispatched during the month', { col: 'col-sm-6 col-lg-3' }) %>
              </div>
            </div>
          </div>

          <!-- 6.6(a)(ii) -->
          <div class="sub-section">
            <div class="sub-head">
              <div class="form-check form-switch">
                <input type="checkbox" class="form-check-input toggle-section" name="exp_662_enabled" id="exp662" data-target="exp662Fields" <%= f.exp_662_enabled ? 'checked' : '' %>>
                <label class="form-check-label" for="exp662">6.6(a)(ii) Export under OGL — raw sugar (incl. SEZ refinery)</label>
              </div>
            </div>
            <div class="collapse-fields" id="exp662Fields" <%= f.exp_662_enabled ? '' : 'hidden' %>>
              <div class="row g-3">
                <%- textField('exp_662_order_no', 'Release order no.', { col: 'col-sm-6 col-lg-3' }) %>
                <%- dateField('exp_662_date', 'Release order date', { col: 'col-sm-6 col-lg-3' }) %>
                <%- numField('exp_662_qty_released', 'Qty released', { col: 'col-sm-6 col-lg-3' }) %>
                <%- numField('exp_662_qty_dispatched', 'Qty dispatched during the month', { col: 'col-sm-6 col-lg-3' }) %>
              </div>
            </div>
          </div>

          <!-- 6.6(a)(iii) -->
          <div class="sub-section">
            <div class="sub-head">
              <div class="form-check form-switch">
                <input type="checkbox" class="form-check-input toggle-section" name="exp_663_enabled" id="exp663" data-target="exp663Fields" <%= f.exp_663_enabled ? 'checked' : '' %>>
                <label class="form-check-label" for="exp663">6.6(a)(iii) Export under OGL — raw sugar sold to refineries by invoice</label>
              </div>
            </div>
            <div class="collapse-fields" id="exp663Fields" <%= f.exp_663_enabled ? '' : 'hidden' %>>
              <div class="row g-3">
                <%- textField('exp_663_order_no', 'Release order no.', { col: 'col-sm-6 col-lg-3' }) %>
                <%- dateField('exp_663_date', 'Release order date', { col: 'col-sm-6 col-lg-3' }) %>
                <%- numField('exp_663_qty_dispatched', 'Qty dispatched during the month', { col: 'col-sm-6 col-lg-3' }) %>
                <%- textField('exp_663_mill_name', 'Name of mill / refinery sold to', { col: 'col-sm-6 col-lg-3' }) %>
              </div>
            </div>
          </div>

          <!-- 6.6(b) -->
          <div class="sub-section">
            <div class="sub-head">
              <div class="form-check form-switch">
                <input type="checkbox" class="form-check-input toggle-section" name="exp_66b_enabled" id="exp66b" data-target="exp66bFields" <%= f.exp_66b_enabled ? 'checked' : '' %>>
                <label class="form-check-label" for="exp66b">6.6(b) Export under AAS (white sugar)</label>
              </div>
            </div>
            <div class="collapse-fields" id="exp66bFields" <%= f.exp_66b_enabled ? '' : 'hidden' %>>
              <div class="row g-3">
                <%- textField('exp_66b_order_no', 'Export order no.', { col: 'col-sm-6 col-lg-3' }) %>
                <%- dateField('exp_66b_date', 'Export order date', { col: 'col-sm-6 col-lg-3' }) %>
                <%- numField('exp_66b_qty_released', 'Qty released', { col: 'col-sm-6 col-lg-3' }) %>
                <%- numField('exp_66b_qty_received', 'Qty received during the month', { col: 'col-sm-6 col-lg-3' }) %>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= 6. IMPORT ================= -->
      <section class="card form-section" id="sec-import">
        <div class="card-header"><span class="sec-num">6</span><i class="bi bi-box-arrow-in-down-right"></i> Import</div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-sm-6 col-lg-4">
              <div class="fld">
                <label class="fld-label" for="importApplicable">Is there any import applicable?</label>
                <select name="import_applicable" id="importApplicable" class="form-select fld-input" onchange="toggleImportFields()">
                  <option value="No" <%= f.import_applicable !== 'Yes' ? 'selected' : '' %>>No</option>
                  <option value="Yes" <%= f.import_applicable === 'Yes' ? 'selected' : '' %>>Yes</option>
                </select>
                <small class="fld-hint">Choosing “No” submits all three import quantities as 0.00.</small>
              </div>
            </div>
          </div>
          <div id="importFields" class="mt-3" <%= f.import_applicable === 'Yes' ? '' : 'hidden' %>>
            <div class="row g-3">
              <%- numField('import_ogl_white', '6.7(a)(i) Import under OGL — white / refined sugar', { tip: '6.7 (a) Import under OGL - (i) White/refined Sugar - Qty Received - During the Month (MT)' }) %>
              <%- numField('import_ogl_raw', '6.7(a)(ii) Import under OGL — raw sugar', { tip: '6.7 (a) Import under OGL - (ii) Raw Sugar - Qty Received - During the Month (MT)' }) %>
              <%- numField('import_aas', '6.7(b) Import under AAS', { tip: '6.7 (b) Import under AAS - Qty Received - During the Month (MT)' }) %>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= 7. STOCK ================= -->
      <section class="card form-section" id="sec-stock">
        <div class="card-header"><span class="sec-num">7</span><i class="bi bi-boxes"></i> Stock of Sugar (MT)</div>
        <div class="card-body">
          <div class="stock-grid">
            <div class="stock-head">
              <span></span><span>Opening stock</span><span>Closing stock</span>
            </div>

            <div class="stock-group-label"><i class="bi bi-building"></i> Factory premises</div>

            <div class="stock-row">
              <span class="stock-label">White sugar</span>
              <span><input type="text" name="stock_factory_white_open" class="form-control fld-input js-num" inputmode="decimal" placeholder="0.00" value="<%= f.stock_factory_white_open || '' %>"></span>
              <span class="stock-derived" title="NSWS derives this figure and rejects the filing if it is sent">Derived by NSWS</span>
            </div>
            <div class="stock-row">
              <span class="stock-label">BISS / brown sugar</span>
              <span><input type="text" name="stock_factory_biss_open" class="form-control fld-input js-num" inputmode="decimal" placeholder="0.00" value="<%= f.stock_factory_biss_open || '' %>"></span>
              <span><input type="text" name="stock_factory_biss_close" class="form-control fld-input js-num" inputmode="decimal" placeholder="0.00" value="<%= f.stock_factory_biss_close || '' %>"></span>
            </div>
            <div class="stock-row">
              <span class="stock-label">Raw sugar</span>
              <span><input type="text" name="stock_factory_raw_open" class="form-control fld-input js-num" inputmode="decimal" placeholder="0.00" value="<%= f.stock_factory_raw_open || '' %>"></span>
              <span class="stock-derived" title="NSWS derives this figure and rejects the filing if it is sent">Derived by NSWS</span>
            </div>

            <div class="stock-group-label"><i class="bi bi-shop"></i> Outside godown (duty paid)</div>

            <div class="stock-row">
              <span class="stock-label">White sugar</span>
              <span><input type="text" name="stock_godown_white_open" class="form-control fld-input js-num" inputmode="decimal" placeholder="0.00" value="<%= f.stock_godown_white_open || '' %>"></span>
              <span><input type="text" name="stock_godown_white_close" class="form-control fld-input js-num" inputmode="decimal" placeholder="0.00" value="<%= f.stock_godown_white_close || '' %>"></span>
            </div>
            <div class="stock-row">
              <span class="stock-label">BISS / brown sugar</span>
              <span><input type="text" name="stock_godown_biss_open" class="form-control fld-input js-num" inputmode="decimal" placeholder="0.00" value="<%= f.stock_godown_biss_open || '' %>"></span>
              <span><input type="text" name="stock_godown_biss_close" class="form-control fld-input js-num" inputmode="decimal" placeholder="0.00" value="<%= f.stock_godown_biss_close || '' %>"></span>
            </div>
            <div class="stock-row">
              <span class="stock-label">Raw sugar</span>
              <span><input type="text" name="stock_godown_raw_open" class="form-control fld-input js-num" inputmode="decimal" placeholder="0.00" value="<%= f.stock_godown_raw_open || '' %>"></span>
              <span><input type="text" name="stock_godown_raw_close" class="form-control fld-input js-num" inputmode="decimal" placeholder="0.00" value="<%= f.stock_godown_raw_close || '' %>"></span>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= 8. PACKING ================= -->
      <section class="card form-section" id="sec-packing">
        <div class="card-header"><span class="sec-num">8</span><i class="bi bi-bag-check"></i> Packing Details of Sugar (MT)</div>
        <div class="card-body">
          <div class="row g-3">
            <%- numField('pack_jute_50', '50 kg jute bag', { col: 'col-sm-6 col-lg-3' }) %>
            <%- numField('pack_jute_100', '100 kg jute bag', { col: 'col-sm-6 col-lg-3' }) %>
            <%- numField('pack_pp_50', '50 kg PP / HDPE bag', { col: 'col-sm-6 col-lg-3' }) %>
            <%- numField('pack_other', 'Other retail bags (≤ 25 kg, &gt; 100 kg) / loose', { col: 'col-sm-6 col-lg-3', tip: 'Other Retail Bags (<= 25 Kg and > 100 Kg)/ Loose Sugar - Qty in MT' }) %>
          </div>
          <div class="calc-strip" data-sum="pack_jute_50,pack_jute_100,pack_pp_50,pack_other">
            <i class="bi bi-calculator"></i> Total packed quantity: <strong>0.00</strong> MT
          </div>
        </div>
      </section>

      <!-- ================= 9. CANE DUES ================= -->
      <section class="card form-section" id="sec-dues">
        <div class="card-header"><span class="sec-num">9</span><i class="bi bi-cash-stack"></i> Cane Dues Data</div>
        <div class="card-body">
          <p class="sec-help"><i class="bi bi-lightbulb"></i> Season labels follow the sugar season chosen in section 1 — the current season plus the four preceding seasons.</p>

          <div class="sub-section season-current">
            <div class="sub-head">
              <h6><i class="bi bi-star-fill"></i> Current season <span class="pill pill-accent" id="caneSeason0"><%= f.sugarSeason || '—' %></span></h6>
            </div>
            <div class="row g-3">
              <%- numField('cane_current_payable', 'Cane price payable during the month', { unit: '₹ Cr' }) %>
              <%- numField('cane_current_paid', 'Cane price paid during the month', { unit: '₹ Cr' }) %>
              <%- intField('cane_current_farmers', 'No. of farmers cane procured from') %>
            </div>
          </div>

          <% for (let i = 1; i <= 4; i++) { %>
            <div class="sub-section">
              <div class="sub-head">
                <h6><i class="bi bi-clock-history"></i> Previous season <span class="pill pill-muted" id="caneSeason<%= i %>">—</span></h6>
              </div>
              <div class="row g-3">
                <%- numField('cane_prev' + i + '_crushed', 'Cane crushed') %>
                <%- numField('cane_prev' + i + '_production', 'Sugar production') %>
                <%- numField('cane_prev' + i + '_recovery', 'Sugar recovery', { unit: '%' }) %>
                <%- numField('cane_prev' + i + '_payable', 'Cane price payable during the season', { unit: '₹ Cr' }) %>
                <%- numField('cane_prev' + i + '_paid', 'Cane price paid during the month (arrears)', { unit: '₹ Cr' }) %>
                <%- intField('cane_prev' + i + '_farmers', 'No. of farmers cane procured from') %>
              </div>
            </div>
          <% } %>
        </div>
      </section>

      <div class="form-bottom-spacer"></div>
    </form>
  </main>
</div>

<!-- Sticky action bar -->
<div class="sticky-actions">
  <div class="sticky-actions-inner">
    <div class="sticky-status" id="stickyStatus">
      <i class="bi bi-info-circle"></i> <span>Fill in the sections that apply, then preview the NSWS payload.</span>
    </div>
    <div class="sticky-buttons">
      <button type="button" class="btn btn-ghost" id="clearLocalBtn"><i class="bi bi-eraser me-1"></i>Reset</button>
      <button type="submit" form="p2Form" class="btn btn-accent btn-lg"><i class="bi bi-eye me-2"></i>Preview JSON</button>
    </div>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>
<div class="fld-tooltip" id="fldTooltip" role="tooltip"></div>

<%- include('partials/footer') %>
